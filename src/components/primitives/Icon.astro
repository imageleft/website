---
/**
 * Inline-SVG icon primitive. Single source of truth for all icons used on the site.
 * UI icons render as currentColor strokes; brand marks render with their canonical fill.
 */

type UIIcon =
  | 'arrow-return'
  | 'arrow-right'
  | 'compass'
  | 'database'
  | 'hand'
  | 'rocket'
  | 'command'
  | 'plus'
  | 'minus'
  | 'quote'
  | 'video';

type BrandIcon =
  | 'stripe'
  | 'paystack'
  | 'mpesa'
  | 'github'
  | 'instagram'
  | 'x'
  | 'facebook'
  | 'linkedin'
  | 'whatsapp'
  | 'google-meet'
  | 'windows'
  | 'android'
  | 'vscode';

export type IconName = UIIcon | BrandIcon;

interface Props {
  name: IconName;
  size?: string | number;
  /** Brand icons render in their canonical color by default; pass `currentColor` to override. */
  brandUseCurrent?: boolean;
  class?: string;
  ariaLabel?: string;
}

const {
  name,
  size = 20,
  brandUseCurrent = false,
  class: className = '',
  ariaLabel,
}: Props = Astro.props;

const titled = ariaLabel !== undefined;
---

