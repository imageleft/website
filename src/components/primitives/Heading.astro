---
interface Props {
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  size?: 'xl' | '2xl' | '3xl' | '4xl' | '5xl' | '6xl' | '7xl';
  class?: string;
}
const { level = 2, size = '3xl', class: className = '' }: Props = Astro.props;
const Tag = `h${level}` as 'h1' | 'h2' | 'h3' | 'h4' | 'h5' | 'h6';
const sizeClass = {
  xl: 'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
  '4xl': 'text-4xl',
  '5xl': 'text-5xl',
  '6xl': 'text-6xl',
  '7xl': 'text-7xl',
}[size];
---

<Tag class:list={['font-display tracking-tight', sizeClass, className]}>
  <slot />
</Tag>
