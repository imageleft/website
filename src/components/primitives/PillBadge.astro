---
interface Props {
  variant?: 'outline' | 'dark' | 'soft' | 'dark-outline';
  dotColor?: string;
  class?: string;
}
const { variant = 'outline', dotColor, class: className = '' }: Props = Astro.props;

const variants = {
  outline: 'border border-border bg-surface text-ink',
  dark: 'border border-ink-strong bg-ink-strong text-surface',
  soft: 'border border-border bg-surface-soft text-ink',
  'dark-outline': 'border border-white/20 bg-white/5 text-surface',
};
---

<span
  class:list={[
    'inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium tracking-wide uppercase',
    variants[variant],
    className,
  ]}
>
  {
    dotColor && (
      <span
        class="inline-block h-2 w-2 rounded-full"
        style={`background-color: ${dotColor}`}
        aria-hidden="true"
      />
    )
  }
  <slot />
</span>
