---
interface Props {
  /** Fill color — pass a token var() or hex */
  color?: string;
  /** Size in CSS units (defaults to 1em so it scales with surrounding font) */
  size?: string;
  class?: string;
}
const {
  color = 'var(--color-decoration-pink)',
  size = '1em',
  class: className = '',
}: Props = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 100 100"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  class:list={['inline-block align-middle', className]}
  aria-hidden="true"
>
  <path
    d="M50 0
       C50 25 25 25 0 50
       C25 50 25 75 50 100
       C50 75 75 75 100 50
       C75 50 75 25 50 0 Z"
    fill={color}></path>
</svg>
