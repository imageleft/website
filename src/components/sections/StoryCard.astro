---
import Icon from '../primitives/Icon.astro';
import PillBadge from '../primitives/PillBadge.astro';
import Text from '../primitives/Text.astro';
import type { CustomerStory } from '../../content/schemas';

interface Props {
  story: CustomerStory;
}
const { story }: Props = Astro.props;
---

<a
  href={`/stories/${story.slug}`}
  class="border-border bg-surface-soft hover:border-border-strong group flex h-full flex-col gap-6 rounded-[var(--radius-md)] border p-6 transition-colors"
>
  <div class="flex items-center justify-between">
    <PillBadge variant="outline" class="!px-3 !py-0.5 !text-[10px]">{story.industry}</PillBadge>
    <Icon
      name="arrow-right"
      size={18}
      class="text-muted group-hover:text-accent transition-colors"
    />
  </div>

  <Icon name="quote" size={28} class="text-accent" />

  <div class="flex-1 space-y-3">
    <h3
      class="text-ink group-hover:text-accent text-base leading-snug font-semibold transition-colors"
    >
      {story.summary}
    </h3>
    <Text muted size="sm">{story.customer}</Text>
  </div>

  {
    story.metrics.length > 0 && (
      <dl class="border-border grid grid-cols-2 gap-x-4 gap-y-2 border-t pt-4">
        {story.metrics.slice(0, 2).map((m) => (
          <div>
            <dt class="text-muted text-[10px] tracking-wider uppercase">{m.label}</dt>
            <dd class="text-ink text-sm font-semibold">{m.value}</dd>
          </div>
        ))}
      </dl>
    )
  }
</a>
