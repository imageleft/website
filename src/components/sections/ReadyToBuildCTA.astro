---
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Text from '../primitives/Text.astro';
import Button from '../primitives/Button.astro';
import PillBadge from '../primitives/PillBadge.astro';

interface Props {
  /** Eyebrow tag — defaults to CONTACT but pages may override (e.g. "GET IN TOUCH") */
  eyebrow?: string;
}
const { eyebrow = 'Contact' }: Props = Astro.props;
---

<section class="py-32">
  <Container size="lg" class="text-center">
    <PillBadge>{eyebrow}</PillBadge>

    <Heading level={2} size="6xl" class="mx-auto mt-6 max-w-3xl">
      Ready to build something worth building?
    </Heading>

    <Text muted class="mx-auto mt-6 max-w-xl">
      A 30-minute discovery call. No pitch decks, no hard sells. We'll listen to what you're
      building and tell you honestly whether we're the right fit.
    </Text>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <Button href="/contact" variant="accent" size="lg">Book a Free Call</Button>
      <Button href="mailto:info@imageleft.com" variant="outline" size="lg">
        Email Us Directly
      </Button>
    </div>

    <Text size="sm" muted class="mt-6">We respond within 24 hours. No automated sequences</Text>
  </Container>
</section>
