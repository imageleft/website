---
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Text from '../primitives/Text.astro';
import Button from '../primitives/Button.astro';
import PillBadge from '../primitives/PillBadge.astro';
import FAQAccordion from '../islands/FAQAccordion.tsx';

const faqs = [
  {
    question: 'How long does it take to build a product?',
    answer:
      'Most ideation-to-launch projects ship in days depending on scope and integrations. For complex projects, The imageleft team shares a phase-by-phase plan after a discovery call.',
  },
  {
    question: 'Do you work with early-stage founders?',
    answer:
      'imageleft can be used by both pre-seed through Series A teams. Scope is adjusted to match your milestones.',
  },
  {
    question: 'What does it cost to build a product?',
    answer:
      'You can access all of our premium features today at USD20. See the Pricing page for details.',
  },
  {
    question: 'Can you improve an existing product?',
    answer:
      'Often yes. imageleft audits your codebase and gives you a roadmap, then propose targeted phases: refactor, redesign, or extend.',
  },
];
---

<section class="py-24">
  <Container size="md">
    <div class="space-y-3 text-center">
      <PillBadge>FAQ</PillBadge>
      <Heading level={2} size="6xl">Questions founders often ask</Heading>
      <Text muted class="mx-auto max-w-md">
        Have questions? We have answers. Everything you need to know before you begin.
      </Text>
    </div>

    <div class="mt-12">
      <FAQAccordion client:visible items={faqs} />
    </div>

    <div class="mt-10 flex justify-center">
      <Button href="/contact" variant="outline">Ask us anything</Button>
    </div>
  </Container>
</section>
