---
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Text from '../primitives/Text.astro';
import PillBadge from '../primitives/PillBadge.astro';
import Icon from '../primitives/Icon.astro';

const stories = [
  {
    quote:
      'We translated a complex payments idea into a real platform. From product brief to launch in 14 weeks.',
    author: 'Bibi Gabriel',
    role: 'Founder, Fintech Startup',
    metrics: [
      { label: 'Time to launch', value: '14 weeks' },
      { label: 'Active users at MVP', value: '1,200' },
    ],
  },
  {
    quote:
      'A clinical-records platform built with care. Compliance, audit trails, and a UI that nurses actually want to use.',
    author: 'Adaeze Okafor',
    role: 'Founder, HealthTech',
    metrics: [
      { label: 'Compliance audit', value: 'Passed first try' },
      { label: 'Avg session time', value: '8 min' },
    ],
  },
  {
    quote:
      'They challenged our scope and got us to launch fast. Pushed back on a third of our spec — that saved us months.',
    author: 'Tom Reyes',
    role: 'Founder, B2B SaaS',
    metrics: [
      { label: 'Scope cut', value: '38%' },
      { label: 'Time saved', value: '11 weeks' },
    ],
  },
];
---

<section class="py-24">
  <Container size="xl">
    <div class="space-y-3 text-center">
      <PillBadge>Customer Stories</PillBadge>
      <Heading level={2} size="5xl">What founders say</Heading>
      <Text muted class="mx-auto max-w-md">
        We work closely with founders to build products that actually deliver.
      </Text>
    </div>

    <ul class="mt-12 grid grid-cols-1 gap-6 md:grid-cols-3">
      {
        stories.map((story) => (
          <li class="border-border bg-surface-soft flex flex-col gap-6 rounded-[var(--radius-md)] border p-6">
            <Icon name="quote" size={28} class="text-accent" />

            <p class="text-ink flex-1 text-base leading-relaxed font-medium">{story.quote}</p>

            <dl class="border-border grid grid-cols-2 gap-x-4 gap-y-2 border-t pt-4">
              {story.metrics.map((m) => (
                <div>
                  <dt class="text-muted text-[10px] tracking-wider uppercase">{m.label}</dt>
                  <dd class="text-ink text-sm font-semibold">{m.value}</dd>
                </div>
              ))}
            </dl>

            <div>
              <p class="text-ink text-sm font-semibold">{story.author}</p>
              <p class="text-muted text-xs">{story.role}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
