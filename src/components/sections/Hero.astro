---
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Text from '../primitives/Text.astro';
import Button from '../primitives/Button.astro';
import Icon from '../primitives/Icon.astro';
import HeroStripe from './HeroStripe.astro';
---

<section class="dotted-bg relative">
  <HeroStripe side="left" tone="pink" avatar="/sections/hero/avatar-left.png" />
  <HeroStripe side="right" tone="lavender" avatar="/sections/hero/avatar-right.png" />

  <Container size="xl" class="relative pt-32 pb-24 text-center">
    <div
      id="hero-install-command"
      class="bg-ink-strong shadow-soft mx-auto flex w-fit items-center gap-4 rounded-full border border-white/10 py-2.5 pr-2.5 pl-6"
    >
      <code class="text-surface/90 font-mono text-sm select-all sm:text-base">npm i imageleft</code>
      <button
        type="button"
        id="hero-copy-btn"
        aria-label="Copy install command"
        class="group text-surface focus-visible:outline-accent flex h-9 w-9 shrink-0 cursor-pointer items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-white/20 focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        <Icon name="copy" size={16} class="hero-copy-icon" />
        <Icon name="check" size={16} class="hero-check-icon text-decoration-mint hidden" />
      </button>
    </div>

    <Heading size="xl" class="mx-auto mt-36 max-w-xl">
      <b>imageleft</b> combines product thinking, design, and engineering to build systems that work,
      not just features.
    </Heading>

    <div class="mt-10 flex justify-center">
      <Button href="/contact" variant="accent" size="lg">
        <Icon name="google-meet" size={20} brandUseCurrent ariaLabel="Google Meet" />
        Book a Free Call
      </Button>
    </div>

    <div class="mt-20 flex justify-center px-4">
      <img
        src="/sections/hero/partners.png"
        alt="Trusted by Stripe, Paystack, M-PESA, GitHub and partners"
        loading="lazy"
        width="1300"
        height="130"
        class="h-12 w-auto opacity-90 md:h-14"
      />
    </div>
  </Container>
</section>

<script>
  const btn = document.getElementById('hero-copy-btn');
  const wrapper = document.getElementById('hero-install-command');
  const commandEl = wrapper?.querySelector('code');

  if (btn && commandEl) {
    let resetTimer: ReturnType<typeof setTimeout>;

    btn.addEventListener('click', async () => {
      const text = commandEl.textContent?.trim() ?? '';
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        return;
      }

      const copyIcon = btn.querySelector('.hero-copy-icon');
      const checkIcon = btn.querySelector('.hero-check-icon');
      copyIcon?.classList.add('hidden');
      checkIcon?.classList.remove('hidden');
      btn.setAttribute('aria-label', 'Copied!');

      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        copyIcon?.classList.remove('hidden');
        checkIcon?.classList.add('hidden');
        btn.setAttribute('aria-label', 'Copy install command');
      }, 1800);
    });
  }
</script>
