---
import Container from '../primitives/Container.astro';
import Heading from '../primitives/Heading.astro';
import Text from '../primitives/Text.astro';
import Button from '../primitives/Button.astro';
import PillBadge from '../primitives/PillBadge.astro';

const apiBase = import.meta.env.BACKOFFICE_URL ?? '';

const inputClass =
  'mt-1.5 w-full rounded-[var(--radius-md)] border border-[var(--color-border)] bg-surface px-4 py-2.5 text-base text-ink placeholder:text-muted focus:border-accent focus:outline-none transition-colors';
---

<section class="dotted-bg relative py-24">
  <Container size="md" class="relative">
    <div class="space-y-3 text-center">
      <PillBadge>Contact</PillBadge>
      <Heading level={1} size="6xl">Tell us what you're building.</Heading>
      <Text muted class="mx-auto max-w-xl">
        A quick brief is enough to get us thinking. We respond within 24 hours, no automated
        sequences.
      </Text>
    </div>

    {/* data-contact-form is the hook used by the inline script to attach the submit listener. */}
    <form
      data-contact-form
      data-api-url={`${apiBase}/api/v1/public/leads`}
      class="mx-auto mt-12 grid max-w-xl grid-cols-1 gap-5"
      novalidate
    >
      <label class="block">
        <span class="text-ink block text-sm font-medium">Name</span>
        <input name="name" type="text" required placeholder="Your full name" class={inputClass} />
      </label>

      <label class="block">
        <span class="text-ink block text-sm font-medium">Email</span>
        <input
          name="email"
          type="email"
          required
          placeholder="you@example.com"
          class={inputClass}
        />
      </label>

      <label class="block">
        <span class="text-ink block text-sm font-medium">Subject</span>
        <input
          name="subject"
          type="text"
          required
          placeholder="What's this about?"
          class={inputClass}
        />
      </label>

      <label class="block">
        <span class="text-ink block text-sm font-medium">Message</span>
        <textarea
          name="message"
          rows="6"
          required
          placeholder="Briefly describe what you're working on, where you are now, and what you'd like help with."
          class={inputClass}></textarea>
      </label>

      <Button type="submit" variant="accent" size="lg" class="w-full">Send message</Button>

      <p id="contact-status" class="hidden text-center text-sm" aria-live="polite"></p>
    </form>
  </Container>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact-form]');
  const LEADS_URL = form?.dataset.apiUrl ?? '/api/v1/public/leads';
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const statusEl = document.getElementById('contact-status');

  function setStatus(msg: string, isError = false) {
    if (!statusEl) return;
    statusEl.textContent = msg;
    statusEl.className = isError
      ? 'block text-center text-sm text-red-600'
      : 'block text-center text-sm text-green-700';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form) return;

    const data = new FormData(form);
    const name = String(data.get('name') ?? '').trim();
    const email = String(data.get('email') ?? '').trim();
    const message = String(data.get('message') ?? '').trim();

    // Split name into firstName / lastName (best-effort)
    const [firstName, ...rest] = name.split(' ');
    const lastName = rest.join(' ') || undefined;

    if (submitBtn) submitBtn.setAttribute('disabled', '');

    try {
      const res = await fetch(LEADS_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          source: 'CONTACT',
          firstName,
          lastName,
          email,
          message,
          company_url: '', // honeypot — must be empty
        }),
      });

      if (res.ok || res.status === 201) {
        setStatus('Message sent! We\'ll get back to you within 24 hours.');
        form.reset();
      } else if (res.status === 429) {
        setStatus('Too many requests — please try again in a minute.', true);
      } else {
        setStatus('Something went wrong. Please email us directly at hello@imageleft.com.', true);
      }
    } catch {
      setStatus('Could not send — check your connection and try again.', true);
    } finally {
      if (submitBtn) submitBtn.removeAttribute('disabled');
    }
  });
</script>
