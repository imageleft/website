---
import PillBadge from '../primitives/PillBadge.astro';
import Text from '../primitives/Text.astro';
import type { BlogPost } from '../../content/schemas';

interface Props {
  post: BlogPost;
}
const { post }: Props = Astro.props;

const formattedDate = post.publishedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article
  class="border-border bg-surface flex flex-col overflow-hidden rounded-[var(--radius-md)] border"
>
  <a href={`/blog/${post.slug}`} class="block">
    {post.coverImage ? (
      <img
        src={post.coverImage}
        alt={post.title}
        class="aspect-video w-full object-cover rounded-t-lg"
      />
    ) : (
      <div class="aspect-video w-full relative overflow-hidden rounded-t-lg bg-[#05021b] flex items-center justify-center">
      
        <div class="absolute inset-0 opacity-30">
          <div class="absolute left-1/2 top-1/2 h-32 w-32 -translate-x-1/2 -translate-y-1/2 rounded-full bg-violet-500 blur-2xl"></div>
        </div>
       
        <span class="relative text-8xl font-bold text-white/10 select-none font-display">
          {post.title.charAt(0).toUpperCase()}
        </span>
       
        <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black/60 to-transparent">
          <p class="text-xs font-medium text-white/80 line-clamp-1">{post.title}</p>
        </div>
      </div>
    )}
  </a>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between">
      {
        post.tags.length > 0 && (
          <PillBadge variant="outline" class="!px-3 !py-0.5 !text-[10px]">
            {post.tags[0]}
          </PillBadge>
        )
      }
      <Text size="sm" muted class="!text-xs">{formattedDate}</Text>
    </div>
    <a href={`/blog/${post.slug}`} class="hover:text-accent text-ink text-base font-semibold">
      {post.title}
    </a>
    <Text muted size="sm" class="line-clamp-2">{post.excerpt}</Text>
    <div class="border-border mt-auto flex items-center justify-between border-t pt-3">
      <p class="text-xs">
        <span class="text-muted">By </span>
        <span class="text-ink font-medium">{post.author.name}</span>
      </p>
    </div>
  </div>
</article>
