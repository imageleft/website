---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Text from '../../components/primitives/Text.astro';
import PillBadge from '../../components/primitives/PillBadge.astro';
import Button from '../../components/primitives/Button.astro';
import ReadyToBuildCTA from '../../components/sections/ReadyToBuildCTA.astro';
import Icon from '../../components/primitives/Icon.astro';

const features = [
  {
    title: 'Code',
    description: 'Learn programming languages and frameworks used today',
  },
  {
    title: 'Artificial Intelligence',
    description: 'Master AI concepts.',
  },
  {
    title: 'Projects',
    description: 'Build products to showcase.',
  },
  {
    title: 'Community',
    description: 'Learn and engage with a community of builders.',
  },
];

const tracks = [
  'Programming Fundamentals, Web & AI Integration',
  'Sales & Revenue Systems',
  'Marketing, Positioning & Growth',
  'Writing',
];

const programs = [
  { title: 'Programming', description: 'Full-stack and AI-powered...' },
  { title: 'Sales', description: 'Close deals. Build pipelines...' },
  { title: 'Marketing', description: 'Build audiences. Drive demand...' },
  { title: 'Writing', description: 'From idea to words to action...' },
];
---

<BaseLayout
  title="imageleft | Academy"
  description="Online learning materials for builders in the AI era."
  ogImage="/og/academy.png"
>
  <SiteHeader slot="header" />

  <!-- HERO -->
  <section class="px-4 py-10 md:px-8">
    <div
      class="relative overflow-hidden bg-[#0d0d0d] py-32 text-white before:absolute before:top-0 before:right-0 before:left-0 before:h-16 before:rounded-b-[50%] before:bg-white before:content-[''] after:absolute after:right-0 after:bottom-0 after:left-0 after:h-16 after:rounded-t-[50%] after:bg-white after:content-['']"
    >
      <!-- glow -->
      <div class="absolute inset-0 opacity-20">
        <div
          class="absolute top-0 left-1/2 h-125 w-125 -translate-x-1/2 rounded-full bg-violet-500 blur-3xl"
        >
        </div>
      </div>

      <Container size="xl" class="relative z-10">
        <div class="mx-auto max-w-4xl text-center">
          <PillBadge> imageleft - Academy </PillBadge>

          <Text class="mt-6 text-white/70">
            Online resource designed for builders in the AI era.
          </Text>

          <Heading level={1} size="6xl" class="mt-6 leading-tight text-white">
            Learn How Products are Built
          </Heading>

          <Text class="mx-auto mt-8 max-w-2xl text-lg text-white/70">
            imageleft - Academy is a hands-on live learning experience for builder who want to move
            from tutorial hell to building and shippping working products.
          </Text>

          <div class="mt-10 flex justify-center">
            <Button href="#pricing" variant="accent" size="lg">
              <Icon name="arrow-right" size={16} class="mr-2" />
              Start Learning
            </Button>
          </div>
        </div>
      </Container>
    </div>
  </section>

  <!-- FEATURES -->
  <section class="py-24">
    <Container size="xl">
      <div class="text-center">
        <Heading level={2} size="4xl"> imageleft - Academy combines </Heading>

        <Text muted class="mx-auto mt-4 max-w-2xl">
          Theory(35%) and practice(65%) to prepare you to build in the artificial intelligence era.
        </Text>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        {
          features.map((feature) => (
            <div class="bg-surface shadow-all rounded-[var(--radius-xl)] border border-[var(--color-border)] p-8 transition-all hover:-translate-y-1">
              <Heading level={3} size="xl">
                {feature.title}
              </Heading>

              <Text muted class="mt-4">
                {feature.description}
              </Text>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- LEARNING MATERIALS -->

  <section class="bg-surface py-24">
    <Container size="xl">
      <div class="text-center">
        <Heading level={2} size="4xl"> Learning Notes </Heading>

        <Text muted class="mx-auto mt-4 max-w-2xl">
          Structured notes aligned with skills builders need today.
        </Text>
      </div>

      <ul class="mx-auto mt-16 max-w-2xl space-y-3">
        {
          tracks.map((track) => (
            <li class="bg-background shadow-all flex items-center justify-between rounded-[var(--radius-xl)] border border-[var(--color-border)] px-6 py-5">
              <span class="font-medium">{track}</span>
              <button class="text-accent ml-4 shrink-0 text-sm font-medium transition-opacity hover:opacity-70">
                Paths →
              </button>
            </li>
          ))
        }
      </ul>
    </Container>
  </section>

  <!-- PRICING -->

  <section id="pricing" class="py-24">
    <Container size="xl">
      <div class="text-center">
        <Heading level={2} size="4xl"> Pricing for imageleft - Academy </Heading>

        <Text muted class="mx-auto mt-4 max-w-2xl">
          imageleft is sold as one product for a one-time fee.
        </Text>
      </div>

      <div class="mx-auto mt-16 grid max-w-5xl grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- FREE -->

        <div
          class="bg-surface shadow-all rounded-[var(--radius-2xl)] border border-[var(--color-border)] p-10"
        >
          <Text muted>Free</Text>

          <Heading level={3} size="5xl" class="mt-4"> $0 </Heading>

          <ul class="text-muted mt-8 space-y-4">
            <li>Community access</li>
            <li>Learning materials</li>
            <li>Support</li>
            <li>Onboarding</li>
          </ul>

          <div class="mt-10">
            <Button href="#">Get Started</Button>
          </div>
        </div>

        <!-- PREMIUM -->

        <div class="bg-ink overflow-hidden rounded-[var(--radius-2xl)] text-white">
          <!-- Gradient header -->
          <div
            class="relative p-8 pb-10"
            style="background: linear-gradient(135deg, #7EB3F7 0%, #ece9f6 90%);"
          >
            <div class="flex items-center justify-between">
              <Text class="font-medium text-white">Premium</Text>
              <span class="text-ink rounded-full bg-white px-4 py-1 text-sm font-medium">
                Most Popular
              </span>
            </div>
            <Heading level={3} size="5xl" class="mt-16 text-white"> $20 </Heading>
          </div>

          <!-- Features -->

          <div class="space-y-4 p-8">
            {
              [
                'Learning materials',
                'Live sessions',
                'Project feedback',
                'AI integration guidance',
              ].map((item) => (
                <div class="flex items-center gap-3">
                  <span class="bg-accent flex h-6 w-6 items-center justify-center rounded-full">
                    <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                      <path
                        d="M2 6l3 3 5-5"
                        stroke="white"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  <span class="text-white/80">{item}</span>
                </div>
              ))
            }
          </div>

          <!-- CTA -->
          <div class="px-8 pb-8">
            <Button href="#" variant="accent" class="w-full">Get Started</Button>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- PROGRAMS -->
  <section class="bg-surface py-24">
    <Container size="xl">
      <div class="text-center">
        <Heading level={2} size="4xl"> Theory(35%) and practice(65%) </Heading>

        <Text muted class="mx-auto mt-4 max-w-2xl">
          Prepare for the artificial intelligence era.
        </Text>
      </div>

      <div class="mt-16 grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        {
          programs.map((program) => (
            <div class="bg-background shadow-all flex flex-col rounded-[var(--radius-xl)] border border-[var(--color-border)] p-8">
              <Heading level={3} size="xl">
                {program.title}
              </Heading>

              <Text muted class="mt-3 flex-1">
                {program.description}
              </Text>

              <div class="text-muted mt-8 flex items-center justify-between border-t border-[var(--color-border)] pt-6 text-sm">
                <span class="flex items-center gap-1">15 mins</span>
                <span class="flex items-center gap-1">Beginner to Advanced</span>
              </div>
            </div>
          ))
        }
      </div>
    </Container>
  </section>

  <ReadyToBuildCTA />

  <SiteFooter slot="footer" />
</BaseLayout>
