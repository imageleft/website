---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import Container from '../components/primitives/Container.astro';
import Heading from '../components/primitives/Heading.astro';
import Text from '../components/primitives/Text.astro';
import PillBadge from '../components/primitives/PillBadge.astro';
import Icon from '../components/primitives/Icon.astro';
import IconSquare from '../components/primitives/IconSquare.astro';
import CopyCommand from '../components/primitives/CopyCommand.astro';
import type { IconName } from '../components/primitives/Icon.astro';

type NavItem = { id: string; label: string; icon: IconName };

const nav: { title: string; items: NavItem[] }[] = [
  {
    title: 'Getting Started',
    items: [
      { id: 'overview', label: 'Overview', icon: 'compass' },
      { id: 'platform', label: 'Platform', icon: 'command' },
      { id: 'tools', label: 'Tools', icon: 'database' },
      { id: 'cli', label: 'CLI', icon: 'command' },
    ],
  },
  {
    title: 'Features',
    items: [
      { id: 'build', label: 'Build', icon: 'rocket' },
      { id: 'deploy', label: 'Deploy', icon: 'arrow-right' },
      { id: 'preview', label: 'Preview', icon: 'arrow-return' },
      { id: 'pricing', label: 'Pricing', icon: 'hand' },
    ],
  },
  {
    title: 'Resources',
    items: [{ id: 'rules', label: 'Rules', icon: 'command' }],
  },
];

const toc = nav.flatMap((group) => group.items);

const repos: { name: string; icon: IconName; href: string; desc: string }[] = [
  {
    name: 'Learn',
    icon: 'compass',
    href: '#pricing',
    desc: 'Guided learning as you build.',
  },
  {
    name: 'Build',
    icon: 'command',
    href: '#pricing',
    desc: 'Describe idea in natural language and get a real app.',
  },
  {
    name: 'Ship',
    icon: 'rocket',
    href: '#pricing',
    desc: 'Take payments(MoMo or card or crypto) and go live.',
  },
];
---

<BaseLayout
  title="Documentation | imageleft"
  description="How imageleft works and notes to guide you."
>
  <SiteHeader slot="header" />

  <!-- Hero -->
  <section class="dotted-bg relative overflow-hidden py-20 md:py-28">
    <Container size="lg" class="relative text-center">
      <PillBadge>Documentation</PillBadge>

      <Heading level={1} size="6xl" class="mx-auto mt-6 max-w-3xl">
        A platform to build from zero to live preview.
      </Heading>

      <Text muted size="lg" class="mx-auto mt-6 max-w-xl">
        Guides and references to help you go from idea to working preview.
      </Text>

      <div class="mt-10 flex flex-wrap justify-center gap-2">
        {
          toc.map((item) => (
            <a
              href={`#${item.id}`}
              class="border-border bg-surface text-ink hover:bg-surface-soft rounded-full border px-4 py-2 text-sm transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </Container>
  </section>

  <!-- Docs body: sidebar · content · on-this-page -->
  <Container size="xl" class="py-12 md:py-16">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-[220px_minmax(0,1fr)_200px]">
      <!-- Sidebar nav -->
      <aside class="hidden lg:block">
        <nav data-doc-nav class="sticky top-24 space-y-8">
          {
            nav.map((group) => (
              <div>
                <h2 class="text-muted text-xs font-semibold tracking-widest uppercase">
                  {group.title}
                </h2>
                <ul class="mt-3 space-y-1">
                  {group.items.map((item) => (
                    <li>
                      <a
                        href={`#${item.id}`}
                        class="text-muted hover:text-ink hover:bg-surface-soft flex items-center gap-2.5 rounded-md px-3 py-1.5 text-sm transition-colors"
                      >
                        <Icon name={item.icon} size={16} class="shrink-0" />
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </nav>
      </aside>

      <!-- Main content -->
      <main class="min-w-0 space-y-16">
        <section id="overview" class="scroll-mt-24">
          <Heading level={2} size="4xl">Overview</Heading>
          <Text muted size="lg" class="mt-4">
            Build from nothing to a working app, you can share.
          </Text>
          <Text class="mt-4">
            Describe an idea and get a portable <a
              href="#preview"
              class="text-accent hover:underline">preview</a
            >. Like what you built? Claim it and ship it to Web, Windows, and Android.
          </Text>
        </section>

        <section id="platform" class="scroll-mt-24">
          <Heading level={2} size="4xl">Platform</Heading>
          <Text muted size="lg" class="mt-4">
            Go from idea to launch. Learn, build, and ship.
          </Text>

          <div class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-3">
            {
              repos.map((repo) => (
                <div class="border-border bg-surface rounded-xl border p-5">
                  <div class="flex items-center justify-between gap-3">
                    <IconSquare variant="light" size="size-11">
                      <Icon name={repo.icon} size={22} />
                    </IconSquare>
                    <a
                      href={repo.href}
                      aria-label="Preview"
                      class="border-border bg-surface-soft hover:bg-surface text-ink inline-flex h-8 w-8 items-center justify-center rounded-full border transition-colors"
                    >
                      <Icon name="arrow-right" size={14} class="shrink-0" />
                    </a>
                  </div>
                  <div class="text-ink mt-4 text-base font-semibold">{repo.name}</div>
                  <Text muted size="sm" class="mt-1">
                    {repo.desc}
                  </Text>
                </div>
              ))
            }
          </div>
        </section>

        <section id="tools" class="scroll-mt-24">
          <Heading level={2} size="4xl">Tools</Heading>
          <ul class="mt-4 space-y-3">
            <li class="border-border flex gap-3 border-b pb-3">
              <strong class="text-ink flex w-28 shrink-0 items-center gap-2 text-sm">
                <Icon name="database" size={16} class="text-muted shrink-0" />
                Database
              </strong>
              <Text muted size="sm">One managed source, encrypted at rest.</Text>
            </li>
            <li class="border-border flex gap-3 border-b pb-3">
              <strong class="text-ink flex w-28 shrink-0 items-center gap-2 text-sm"
                ><Icon name="video" size={16} class="text-muted shrink-0" />Media</strong
              >
              <Text muted size="sm">Files and assets available on demand.</Text>
            </li>
          </ul>
        </section>

        <section id="build" class="scroll-mt-24">
          <Heading level={2} size="4xl">Build</Heading>
          <Text muted size="lg" class="mt-4">
            Build once, run everywhere. One codebase is a web, Windows, and Android app.
          </Text>
        </section>

        <section id="deploy" class="scroll-mt-24">
          <Heading level={2} size="4xl">Deploy</Heading>
          <Text muted size="lg" class="mt-4">
            Ship without breaking things. Every release runs through checks before going live.
          </Text>
          <Text class="mt-4">
            Deploys are automatic and reversible: each build ships as one entity, rolling back is
            shipping the previous one.
          </Text>
        </section>
        <section id="preview" class="scroll-mt-24">
          <Heading level={2} size="4xl">Preview</Heading>
          <Text muted size="lg" class="mt-4">
            Eliminate time to proof. Describe an idea and get a working preview.
          </Text>

          <div
            class="bg-accent/8 border-border border-l-accent mt-6 flex gap-3 rounded-xl border border-l-2 p-4"
          >
            <Text size="sm" class="text-ink">
              Every project ships with a shareable <code
                class="bg-surface-soft rounded px-1.5 py-0.5 font-mono text-[0.85em]">preview</code
              >.
            </Text>
          </div>

          <Text class="mt-4"> Share it, get feedback, make it yours. </Text>
        </section>
        <section id="pricing" class="scroll-mt-24">
          <Heading level={2} size="4xl">Pricing</Heading>
          <Text muted size="lg" class="mt-4">
            Build and get preview for free. Pay to own the project.
          </Text>

          <div class="mt-6 flex items-center gap-5 rounded-xl">
            <div class="shrink-0">
              <div class="text-ink text-md">
                Visit our <a href="/pricing" target="#" class="text-accent hover:underline"
                  >pricing</a
                > page for price breakdown
              </div>
              <div class="text-muted text-xs"></div>
            </div>
          </div>
        </section>
        <section id="rules" class="scroll-mt-24">
          <Heading level={2} size="4xl">Rules</Heading>
          <Text muted size="lg" class="mt-4">
            A few principles keep imageleft fast and predictable.
          </Text>
          <ul class="mt-6 space-y-3">
            <li class="border-border flex gap-3 border-b pb-3">
              <strong class="text-ink w-40 shrink-0 text-sm">One codebase</strong>
              <Text muted size="sm">Web, Windows, and Android all ship from a single build.</Text>
            </li>
            <li class="border-border flex gap-3 border-b pb-3">
              <strong class="text-ink w-40 shrink-0 text-sm">Efficient releases</strong>
              <Text muted size="sm">Fast deployment and roll backs to ensure stable releases.</Text>
            </li>
            <li class="flex gap-3">
              <strong class="text-ink w-40 shrink-0 text-sm">Lean at the Core</strong>
              <Text muted size="sm">One database, one default model, one flow.</Text>
            </li>
          </ul>
        </section>

        <div class="border-border bg-surface rounded-xl border p-6">
          <Heading level={2} size="3xl">Contact</Heading>
          <Text muted size="sm" class="mt-3">
            Reach us below to ask questions or share great work.
          </Text>
          <div class="mt-5 flex flex-wrap gap-3">
            <a
              href="https://x.com/imagelefthq"
              target="_blank"
              rel="noopener noreferrer"
              class="border-border hover:bg-surface-soft inline-flex items-center gap-2 rounded-full border px-3 py-2 text-sm transition-colors"
            >
              <Icon name="x" size={16} class="text-muted shrink-0" />
              <span class="text-ink">@imagelefthq</span>
            </a>
            <a
              href="https://instagram.com/imagelefthq"
              target="_blank"
              rel="noopener noreferrer"
              class="border-border hover:bg-surface-soft inline-flex items-center gap-2 rounded-full border px-3 py-2 text-sm transition-colors"
            >
              <Icon name="instagram" size={16} class="text-muted shrink-0" />
              <span class="text-ink">@imageleft</span>
            </a>
            <a
              href="https://linkedin.com/company/imageleft"
              target="_blank"
              rel="noopener noreferrer"
              class="border-border hover:bg-surface-soft inline-flex items-center gap-2 rounded-full border px-3 py-2 text-sm transition-colors"
            >
              <Icon name="linkedin" size={16} class="text-muted shrink-0" />
              <span class="text-ink">imageleft</span>
            </a>
          </div>
        </div>
      </main>

      <!-- On this page -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <h2 class="text-muted text-xs font-semibold tracking-widest uppercase">On this page</h2>
          <ul data-doc-toc class="border-border mt-3 space-y-1 border-l">
            {
              toc.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class="text-muted hover:text-ink -ml-px block border-l border-transparent py-1 pl-3 text-sm transition-colors hover:border-[var(--color-accent)]"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </Container>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* Active section — toggled by the scroll-spy script below. Declared here so the
     styles survive Tailwind's JIT (which won't emit classes only added from JS). */
  [data-doc-nav] a.is-active {
    color: var(--color-ink);
    background-color: var(--color-surface-soft);
    font-weight: 500;
  }
  [data-doc-toc] a.is-active {
    color: var(--color-ink);
    border-color: var(--color-accent);
  }
</style>

<script>
  const sections = Array.from(document.querySelectorAll<HTMLElement>('main section[id]'));
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>(
      '[data-doc-nav] a[href^="#"], [data-doc-toc] a[href^="#"]',
    ),
  );

  if (sections.length && links.length) {
    const setActive = (id: string) => {
      for (const link of links) {
        const active = link.getAttribute('href') === `#${id}`;
        link.classList.toggle('is-active', active);
        if (active) link.setAttribute('aria-current', 'true');
        else link.removeAttribute('aria-current');
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      // Activate a section once its heading crosses into the top of the viewport.
      { rootMargin: '0px 0px -70% 0px', threshold: 0 },
    );

    for (const section of sections) observer.observe(section);
  }
</script>
