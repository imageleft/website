---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Text from '../../components/primitives/Text.astro';
import Button from '../../components/primitives/Button.astro';
import PillBadge from '../../components/primitives/PillBadge.astro';
import { getJobs } from '../../content';
import type { Job } from '../../content/schemas';

export async function getStaticPaths() {
  const jobs = await getJobs();
  return jobs.map((job) => ({
    params: { slug: job.slug },
    props: { job },
  }));
}

interface Props {
  job: Job;
}
const { job } = Astro.props;

const formattedDate = job.postedAt.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout
  title={`${job.title} | Careers | imageleft`}
  description={`${job.title} on the ${job.team} team — ${job.location}.`}
  ogImage="/og/careers.png"
>
  <SiteHeader slot="header" />

  <article class="py-16">
    <Container size="md" class="space-y-8">
      <div>
        <a href="/careers" class="text-muted hover:text-ink text-sm">← All open roles</a>
      </div>

      <div class="space-y-4">
        <div class="flex flex-wrap items-center gap-2">
          <PillBadge variant="outline">{job.team}</PillBadge>
          <Text size="sm" muted class="!text-xs">{job.location}</Text>
          <span class="text-muted text-xs" aria-hidden="true">·</span>
          <Text size="sm" muted class="!text-xs capitalize">{job.type.replace('-', ' ')}</Text>
          <span class="text-muted text-xs" aria-hidden="true">·</span>
          <Text size="sm" muted class="!text-xs">Posted {formattedDate}</Text>
        </div>
        <Heading level={1} size="5xl">{job.title}</Heading>
      </div>

      <div class="article-body">
        <p>{job.description}</p>
      </div>

      <div class="border-border flex flex-wrap items-center gap-3 border-t pt-8">
        <Button
          href={`mailto:hello@imageleft.com?subject=Application: ${encodeURIComponent(job.title)}`}
          variant="accent"
          size="lg"
        >
          Apply for this role
        </Button>
        <Button href="/careers" variant="outline">Back to all roles</Button>
      </div>
    </Container>
  </article>

  <SiteFooter slot="footer" />
</BaseLayout>
