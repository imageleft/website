---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/sections/SiteHeader.astro';
import SiteFooter from '../components/sections/SiteFooter.astro';
import PricingHero from '../components/sections/PricingHero.astro';
import PricingTiers from '../components/sections/PricingTiers.astro';
import PricingProcess from '../components/sections/PricingProcess.astro';
import ReadyToBuildCTA from '../components/sections/ReadyToBuildCTA.astro';
---

<BaseLayout
  title="Pricing | imageleft"
  description="Transparent pricing for design, full product development, and AI automation. Starter from $500. Full builds from $10,000."
  ogImage="/og/pricing.png"
>
  <SiteHeader slot="header" />

  <PricingHero />
  <PricingTiers />
  <PricingProcess />
  <ReadyToBuildCTA />

  <SiteFooter slot="footer" />
</BaseLayout>
