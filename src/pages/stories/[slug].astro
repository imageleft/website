---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/sections/SiteHeader.astro';
import SiteFooter from '../../components/sections/SiteFooter.astro';
import Container from '../../components/primitives/Container.astro';
import Heading from '../../components/primitives/Heading.astro';
import Text from '../../components/primitives/Text.astro';
import Button from '../../components/primitives/Button.astro';
import PillBadge from '../../components/primitives/PillBadge.astro';
import Icon from '../../components/primitives/Icon.astro';
import { getStories } from '../../content';
import type { CustomerStory } from '../../content/schemas';

export async function getStaticPaths() {
  const stories = await getStories();
  return stories.map((story) => ({
    params: { slug: story.slug },
    props: { story },
  }));
}

interface Props {
  story: CustomerStory;
}
const { story } = Astro.props;
---

<BaseLayout title={`${story.customer} | Customer Stories | imageleft`} description={story.summary} ogImage="/og/stories.png">
  <SiteHeader slot="header" />

  <article class="py-16">
    <Container size="md" class="space-y-8">
      <div>
        <a href="/stories" class="text-muted hover:text-ink text-sm">← All stories</a>
      </div>

      <div class="space-y-4">
        <PillBadge>{story.industry}</PillBadge>
        <Heading level={1} size="5xl">{story.customer}</Heading>
        <Icon name="quote" size={32} class="text-accent" />
        <Text size="xl" muted>{story.summary}</Text>
      </div>

      {
        story.metrics.length > 0 && (
          <dl class="border-border bg-surface-soft grid grid-cols-1 gap-6 rounded-[var(--radius-md)] border p-6 sm:grid-cols-3">
            {story.metrics.map((m) => (
              <div>
                <dt class="text-muted text-xs tracking-wider uppercase">{m.label}</dt>
                <dd class="text-ink font-display mt-1 text-2xl tracking-tight">{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }

      <div class="article-body">
        <p>{story.body}</p>
      </div>

      <div class="border-border flex flex-wrap items-center gap-3 border-t pt-8">
        <Button href="/contact" variant="accent">Start a project like this</Button>
        <Button href="/stories" variant="outline">More stories</Button>
      </div>
    </Container>
  </article>

  <SiteFooter slot="footer" />
</BaseLayout>
