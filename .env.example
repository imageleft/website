# ── Content source ──────────────────────────────────────────────────────────────
# "local"  — read blog + jobs from src/content/data/ (default, for local dev)
# "http"   — fetch from the Back Office public API (for production builds)
CONTENT_SOURCE=local

# Required when CONTENT_SOURCE=http — base URL of the imageleft back office.
# No trailing slash. Example: https://office.imageleft.com
BACKOFFICE_URL=http://localhost:3050
